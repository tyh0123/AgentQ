#!/bin/bash
#SBATCH -N 4
#SBATCH -C gpu
#SBATCH -G 16
#SBATCH -q premium
#SBATCH -J qaq_vend
#SBATCH -A m3766
#SBATCH -t 40:00:00

export OMP_NUM_THREADS=1
export OMP_PLACES=threads
export OMP_PROC_BIND=spread

srun -n 16 -c 32 --cpu_bind=cores -G 16 ./main3d.gnu.TPROF.MTMPI.CUDA.ex input_aq_vendor_test
